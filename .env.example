GEMINI_API_KEY=

# NVIDIA NIM API key (nvapi-...). Used by both the landing chat and the KITT
# Core orchestrator. Set this in Cloudflare Pages > Settings > Environment
# variables for the deployed site, and mark it as a Secret.
NVIDIA_API_KEY=

# Optional overrides
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# KITT_LLM_PROVIDER=nvidia
